// Kliqs.me - URL Shortener
// Prisma Schema for PostgreSQL + Auth.js (NextAuth v5)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth.js Models (Required by @auth/prisma-adapter)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  links    Link[]
  qrCodes  QrCode[]
  bioPages BioPage[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Link Model
// Stores shortened URLs. Can be owned by a registered user OR tracked via
// an anonymous session cookie (anonymousSessionId) for unauthenticated users.
// Upon sign-in, anonymous links are synced to the user's account.
// ─────────────────────────────────────────────────────────────────────────────
model Link {
  id                 String    @id @default(cuid())
  slug               String    @unique // 5-char alphanumeric short code
  originalUrl        String
  userId             String?   // null if created by anonymous/guest user
  anonymousSessionId String?   // cookie-based ID for unauthenticated users
  clicks             Int       @default(0)
  expiresAt          DateTime? // null = permanent (authenticated), set = 24h for guests
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([userId])
  @@index([anonymousSessionId])
  @@index([expiresAt])
  @@map("links")
}



// ─────────────────────────────────────────────────────────────────────────────
// QR Code Model
// Stores generated QR codes linked to a destination URL.
// Tracks scans and supports custom styling (foreground/background colors).
// ─────────────────────────────────────────────────────────────────────────────
model QrCode {
  id              String   @id @default(cuid())
  title           String   // User-friendly name for the QR code
  destinationUrl  String   // URL the QR code points to
  foregroundColor String   @default("#000000")
  backgroundColor String   @default("#FFFFFF")
  scans           Int      @default(0)
  userId          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("qr_codes")
}

// ─────────────────────────────────────────────────────────────────────────────
// Bio Page Model
// Stores user-created bio/link-in-bio pages.
// Each page has a unique handle (subdomain-like slug) and a status.
// ─────────────────────────────────────────────────────────────────────────────
model BioPage {
  id          String   @id @default(cuid())
  title       String   // Display name of the bio page
  handle      String   @unique // Unique URL handle (e.g., kliqs.me/bio/handle)
  description String?  // Optional short bio/description
  published   Boolean  @default(false)
  views       Int      @default(0)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([handle])
  @@map("bio_pages")
}
